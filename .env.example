# ============================================================================
# LLOYDS METALS & ENERGY / LLOYDS INFRA - WORKER ONBOARDING SYSTEM
# Configuration Template for Production / Linux Deployment
# ============================================================================

# Backend Port
PORT=5000

# Microsoft Fabric SQL Database Endpoint
FABRIC_SERVER=your-fabric-server.database.fabric.microsoft.com
FABRIC_DATABASE=Worker_onboarding-your-guid-here
FABRIC_PORT=1433

# Microsoft Fabric Full Connection String (ODBC / SQL Driver)
FABRIC_CONNECTION_STRING="Data Source=your-fabric-server.database.fabric.microsoft.com,1433;Initial Catalog=Worker_onboarding-your-guid;Multiple Active Result Sets=False;Connect Timeout=30;Encrypt=True;Trust Server Certificate=False;"

# Authentication Mode:
# Options: 'azure-active-directory-service-principal-secret', 'azure-active-directory-default', 'sql-auth'
FABRIC_AUTH_TYPE=azure-active-directory-service-principal-secret

# Microsoft Entra ID / Azure Active Directory Service Principal
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
FABRIC_WORKSPACE="Software Databases"

# Optional Fallback Credentials
FABRIC_USER=
FABRIC_PASSWORD=
